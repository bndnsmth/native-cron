{
  "name": "native-cron",
  "version": "0.1.0",
  "description": "Cross-platform OS-level cron for Node.js. No daemon, timers, or resident process.",
  "keywords": [
    "cron",
    "launchd",
    "node",
    "scheduler",
    "systemd",
    "task-scheduler"
  ],
  "homepage": "https://github.com/bndnsmth/native-cron#readme",
  "bugs": {
    "url": "https://github.com/bndnsmth/native-cron/issues"
  },
  "license": "MIT",
  "author": "Brandon Smith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndnsmth/native-cron.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jobs": {
      "import": {
        "types": "./dist/jobs.d.ts",
        "default": "./dist/jobs.js"
      },
      "require": {
        "types": "./dist/jobs.d.cts",
        "default": "./dist/jobs.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "npm run build && vp test",
    "prepack": "npm run check && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite-plus": "0.2.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.16.0"
}
